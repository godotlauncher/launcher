  <Target Name="GenerateVersionResourceHeader" BeforeTargets="ResourceCompile">
    <ReadLinesFromFile File="$(PackageJsonPath)">
      <Output TaskParameter="Lines" ItemName="_PackageJsonLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_PackageJson>@(_PackageJsonLines)</_PackageJson>
      <_LauncherVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_PackageJson)', '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</_LauncherVersion>
      <_LauncherVersionCore>$([System.Text.RegularExpressions.Regex]::Match('$(_LauncherVersion)', '^\d+\.\d+\.\d+').Value)</_LauncherVersionCore>
      <_LauncherVersionMajor>$([System.Text.RegularExpressions.Regex]::Replace('$(_LauncherVersionCore)', '^(\d+)\.(\d+)\.(\d+)$', '$1'))</_LauncherVersionMajor>
      <_LauncherVersionMinor>$([System.Text.RegularExpressions.Regex]::Replace('$(_LauncherVersionCore)', '^(\d+)\.(\d+)\.(\d+)$', '$2'))</_LauncherVersionMinor>
      <_LauncherVersionPatch>$([System.Text.RegularExpressions.Regex]::Replace('$(_LauncherVersionCore)', '^(\d+)\.(\d+)\.(\d+)$', '$3'))</_LauncherVersionPatch>
      <_VersionResourceHeader>#define LAUNCHER_VERSION $(_LauncherVersionMajor),$(_LauncherVersionMinor),$(_LauncherVersionPatch),0%0A#define LAUNCHER_VERSION_STRING &quot;$(_LauncherVersion)&quot;</_VersionResourceHeader>
    </PropertyGroup>
    <Error Condition="'$(_LauncherVersionCore)'==''" Text="Unsupported package version: $(_LauncherVersion)" />
    <MakeDir Directories="$(GeneratedIncludeDirectory)" />
    <WriteLinesToFile File="$(GeneratedIncludeDirectory)version-resource.generated.h" Lines="$(_VersionResourceHeader)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
