[gd_resource type="EditorSettings" format={{{editorConfigFormat}}}]

[resource]
text_editor/external/use_external_editor = {{{textEditor.enabled}}}
text_editor/external/exec_path = {{{textEditor.execPath}}}
text_editor/external/exec_flags = {{{textEditor.execFlags}}}
{{#dotnet}}
dotnet/editor/external_editor = {{{externalEditorId}}}
{{#customLaunchConfiguration}}
dotnet/editor/custom_exec_path = {{{execPath}}}
dotnet/editor/custom_exec_path_args = {{{execFlags}}}
{{/customLaunchConfiguration}}
{{/dotnet}}
