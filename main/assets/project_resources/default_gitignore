# Godot 4.0 compatibility:
# Godot 4.0 may store sensitive credentials in export_presets.cfg.
# Uncomment this rule before using Godot 4.0.
#
# If the file is already tracked, remove it from Git's index while keeping
# the local file:
# git rm --cached -- export_presets.cfg
#
# Then commit the .gitignore change and staged removal.
# This does not remove earlier versions from Git history. Rotate any
# credentials that may already have been committed.
# export_presets.cfg

