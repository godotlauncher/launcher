{
    "name": "godot-launcher",
    "productName": "Godot Launcher",
    "desktopName": "org.godotlauncher.launcher.desktop",
    "private": true,
    "version": "1.13.0-beta.1",
    "packageManager": "npm@12.2.0",
    "description": "Godot Launcher is the companion app for managing Godot projects with per-project editor settings.",
    "keywords": [
        "godot",
        "launcher",
        "per-project editor settings",
        "godot engine",
        "godot project manager",
        "godot project launcher",
        "godot version manager",
        "godot custom builds"
    ],
    "type": "module",
    "main": "dist-electron/main.js",
    "author": {
        "name": "Mario Debono - godotlauncher.org",
        "email": "mario@godotlauncher.org",
        "url": "https://godotlauncher.org"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/godotlauncher/launcher.git"
    },
    "bugs": {
        "url": "https://github.com/godotlauncher/launcher/issues"
    },
    "homepage": "https://godotlauncher.org",
    "engines": {
        "node": ">=24.15.0"
    },
    "allowScripts": {
        "electron-winstaller@5.4.0": true,
        "fsevents@2.3.2": true,
        "fsevents@2.3.3": true
    },
    "overrides": {
        "js-yaml": "4.3.2"
    },
    "scripts": {
        "clean:electron": "rimraf dist-electron",
        "dev": "npm-run-all --race --parallel dev:electron dev:react",
        "dev:electron": "npm run transpile:electron && electron .",
        "dev:react": "vite",
        "build": "tsc && vite build",
        "transpile:electron": "run-s clean:electron transpile:electron:compile",
        "transpile:electron:compile": "tsc --project main/tsconfig.build.json && tsc-alias -p main/tsconfig.build.json",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "lint:report": "biome check --reporter=summary --diagnostic-level=error",
        "format": "biome format --write",
        "preview": "vite preview",
        "build:sources": "npm run build && npm run transpile:electron",
        "build:native:git-askpass:x64": "msbuild native/git-credentials-helper/windows-askpass/godot-launcher-git-askpass.vcxproj -target:Rebuild -property:Configuration=Release -property:Platform=x64 -nologo -verbosity:minimal",
        "build:native:git-askpass:arm64": "msbuild native/git-credentials-helper/windows-askpass/godot-launcher-git-askpass.vcxproj -target:Rebuild -property:Configuration=Release -property:Platform=ARM64 -nologo -verbosity:minimal",
        "build:native:git-askpass:windows": "npm run build:native:git-askpass:x64 && npm run build:native:git-askpass:arm64",
        "test:native:git-askpass": "node native/git-credentials-helper/windows-askpass/tests/test.mjs",
        "dist:mac": "npm run build:sources && electron-builder --config electron-builder-config.ts --mac --publish never",
        "dist:linux": "npm run build:sources && electron-builder --config electron-builder-config.ts --linux --publish never",
        "dist:win": "npm run build:native:git-askpass:windows && npm run test:native:git-askpass && npm run dist:win:prepared",
        "dist:win:prepared": "npm run build:sources && electron-builder --config electron-builder-config.ts --win --publish never",
        "test:e2e": "npm run transpile:electron && playwright test",
        "test:unit": "vitest main/src renderer/src",
        "app:dir": "npm run build:sources && electron-builder --dir --config electron-builder-config.ts --publish never",
        "app:dist": "npm run build:sources && electron-builder --config electron-builder-config.ts --publish never",
        "postinstall": "electron-builder install-app-deps",
        "changelog": "auto-changelog",
        "changelog:unreleased": "auto-changelog --unreleased"
    },
    "auto-changelog": {
        "tagPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
        "ignoreCommitPattern": "^(?:[Cc]i|[Rr]elease|[Cc]hore)|changelog|update changelog|updated changelog|update CHANGELOG"
    },
    "dependencies": {
        "@dnd-kit/abstract": "^0.5.0",
        "@dnd-kit/dom": "^0.5.0",
        "@dnd-kit/react": "^0.5.0",
        "@electron-internal/extract-zip": "1.0.5",
        "@mariodebono/di": "3.3.1",
        "@mariodebono/di-app-migrations": "3.3.1",
        "@mariodebono/di-config": "3.3.1",
        "@mariodebono/di-electron": "3.3.1",
        "@mariodebono/di-electron-i18n": "3.3.1",
        "clsx": "^2.1.1",
        "electron-log": "^5.4.4",
        "electron-updater": "^6.8.9",
        "i18next": "^26.4.2",
        "javascript-time-ago": "^2.6.4",
        "jsonc-parser": "^3.3.1",
        "lucide-react": "^1.51.0",
        "mustache": "^4.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.15",
        "react-router": "^8.4.0",
        "reflect-metadata": "^0.2.2",
        "semver": "^7.8.5",
        "which": "^7.0.0",
        "yargs": "^18.2.0",
        "yauzl": "3.4.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/mustache": "^4.2.6",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/semver": "^7.8.0",
        "@types/which": "^3.0.4",
        "@types/yargs": "^17.0.35",
        "@types/yauzl": "3.4.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^5.0.3",
        "auto-changelog": "^2.7.0",
        "daisyui": "^5.7.47",
        "dotenv": "^18.0.5",
        "dotenv-expand": "^13.0.0",
        "electron": "43.7.7",
        "electron-builder": "^26.17.0",
        "npm-run-all": "^4.1.5",
        "rimraf": "^6.1.3",
        "tailwindcss": "^4.3.3",
        "tsc-alias": "^1.9.5",
        "typescript": "^6.0.3",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    }
}
